// A recursive function plus an external libc call.
extern int putchar(int c);

int fib(int n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

int main() {
    int value = fib(9);
    if (value == 34) {
        putchar(79); // O
        putchar(75); // K
        putchar(10);
    }
    return value;
}
